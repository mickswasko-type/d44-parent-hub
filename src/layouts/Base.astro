---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { siteConfig } from '../../site.config';
import { longDate, todayIso } from '../lib/dates';
import { selectableSchools } from '../lib/data';

interface Props { title?: string; description?: string; showDate?: boolean; }
const { title, description = siteConfig.description, showDate = false } = Astro.props;

const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base}${p}`.replace(/\/{2,}/g, '/');
const path = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (p: string) => (path === href(p).replace(/\/$/, '') ? 'page' : undefined);
const buildToday = todayIso();
// Every page needs school names for "Showing Hammerschmidt & JSECC", not just
// pages that happen to contain a school picker to borrow them from.
const schoolNames = JSON.stringify(Object.fromEntries(selectableSchools.map((s) => [s.id, s.shortName])));

// The header styles the first word plain and the rest in the accent colour.
// A single-word name simply renders entirely in the accent colour.
const [brandLead, ...brandTail] = siteConfig.name.split(' ');
const brandRest = brandTail.join(' ');

const nav = [
  { p: '', label: 'Today', icon: 'today' },
  { p: 'calendar', label: 'Calendar', icon: 'calendar' },
  { p: 'resources', label: 'I need to…', icon: 'tasks' },
  { p: 'schools', label: 'Schools', icon: 'building' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title ? `${title} · ${siteConfig.name}` : `${siteConfig.name} — ${siteConfig.tagline}`}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#a4161a" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121212" media="(prefers-color-scheme: dark)" />
    <link rel="manifest" href={href('manifest.webmanifest')} />
    <link rel="icon" href={href('icon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={href('icon-180.png')} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={siteConfig.shortName} />
    <meta name="robots" content="index,follow" />
    <script is:inline>
      /* Preference storage. Defined first so component scripts can rely on it.
         Everything is local to this browser; nothing is ever transmitted. */
      (function () {
        var KEY = 'd44:schools';
        var GRADE_KEY = 'd44:grades';
        function read(key) {
          try { return JSON.parse(localStorage.getItem(key) || '[]'); } catch (e) { return []; }
        }
        function write(key, value) {
          try { localStorage.setItem(key, JSON.stringify(value)); } catch (e) { /* private mode */ }
        }
        window.d44 = {
          schools: function () { return read(KEY); },
          setSchools: function (ids) { write(KEY, ids); if (window.d44.apply) window.d44.apply(); },
          grades: function () { return read(GRADE_KEY); },
          setGrades: function (g) { write(GRADE_KEY, g); },
        };
      })();
    </script>
  </head>
  <body data-build-date={buildToday} data-base={base} data-school-names={schoolNames}>
    <header class="site-head">
      <a class="brand" href={href('')}>
        {brandRest ? <>{brandLead} <span>{brandRest}</span></> : <span>{brandLead}</span>}
      </a>
      {showDate && <span class="today-label" data-today-label>{longDate(buildToday)}</span>}
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-foot">
      <p><strong>{siteConfig.disclaimer}</strong></p>
      <p>
        <a href={siteConfig.officialSiteUrl} rel="noopener">Official District 44 site</a> ·
        <a href={href('about')}>About this site</a> ·
        <a href={href('settings')}>My schools</a>
      </p>
      <p>Where this site and official district communication disagree, the district is right.</p>
    </footer>

    <nav class="tabbar" aria-label="Primary">
      {nav.map((n) => (
        <a href={href(n.p)} aria-current={isCurrent(n.p)}>
          <Icon name={n.icon} />
          <span>{n.label}</span>
        </a>
      ))}
    </nav>

    <script is:inline>
      /* ------------------------------------------------------------------
         The only client-side JavaScript on the site:
           1. reads school preferences from localStorage (never a server),
           2. hides events that are not relevant to those schools,
           3. re-sorts Today / This week / Coming up against the *device*
              clock, so a cached build can never claim the wrong day,
           4. collapses an event published by both the district and a school,
           5. caps the visible "Coming up" list and builds .ics files on click.
         Everything renders correctly without it, just less personally.
         ------------------------------------------------------------------ */
      (function () {
        function localToday() {
          var d = new Date();
          return new Intl.DateTimeFormat('en-CA', {
            timeZone: 'America/Chicago', year: 'numeric', month: '2-digit', day: '2-digit',
          }).format(d);
        }

        function addDays(iso, n) {
          var d = new Date(iso + 'T12:00:00Z');
          d.setUTCDate(d.getUTCDate() + n);
          return d.toISOString().slice(0, 10);
        }

        function schoolWeek(today) {
          var dow = new Date(today + 'T12:00:00Z').getUTCDay();
          if (dow === 0) return [addDays(today, 1), addDays(today, 5)];
          if (dow === 6) return [addDays(today, 2), addDays(today, 6)];
          return [addDays(today, 1 - dow), addDays(today, 5 - dow)];
        }

        /* Move each event card into the section that matches the real date. */
        function repartition(today) {
          /* Deadlines outside the partitioned buckets still have to expire, or
             a build that is a day stale shows one that has already passed.
             Runs before the early return below, so it is not tied to a page
             having partitioned sections. */
          document.querySelectorAll('[data-expires] [data-date]').forEach(function (card) {
            var end = card.getAttribute('data-end') || card.getAttribute('data-date');
            if (end < today) card.remove();
          });

          document.querySelectorAll('[data-newsletter][data-posted]').forEach(function (card) {
            if (card.getAttribute('data-posted') < addDays(today, -10)) card.remove();
          });

          var host = document.querySelector('[data-partition]');
          if (!host) return;
          var week = schoolWeek(today);
          var buckets = {
            today: host.querySelector('[data-bucket="today"]'),
            week: host.querySelector('[data-bucket="week"]'),
            upcoming: host.querySelector('[data-bucket="upcoming"]'),
          };
          if (!buckets.today || !buckets.week || !buckets.upcoming) return;

          var cards = Array.prototype.slice.call(host.querySelectorAll('[data-date]'));
          cards.forEach(function (card) {
            var start = card.getAttribute('data-date');
            var end = card.getAttribute('data-end') || start;
            var target;
            if (start <= today && end >= today) target = buckets.today;
            else if (start > today && start <= week[1] && start >= week[0]) target = buckets.week;
            else if (end < today) { card.remove(); return; }
            else target = buckets.upcoming;
            if (card.parentNode !== target) target.appendChild(card);
          });

          Object.keys(buckets).forEach(function (k) {
            var list = buckets[k];
            var nodes = Array.prototype.slice.call(list.querySelectorAll('[data-date]'));
            nodes.sort(function (a, b) {
              return a.getAttribute('data-date').localeCompare(b.getAttribute('data-date'));
            });
            nodes.forEach(function (n) { list.appendChild(n); });
          });

          var label = document.querySelector('[data-today-label]');
          if (label) {
            label.textContent = new Intl.DateTimeFormat('en-US', {
              timeZone: 'UTC', weekday: 'long', month: 'long', day: 'numeric',
            }).format(new Date(today + 'T12:00:00Z'));
          }
        }

        var hadPrefsOnLoad = window.d44.schools().length > 0;

        /* Hide anything that is not about one of the chosen schools. */
        function apply() {
          var selected = window.d44.schools();
          document.documentElement.setAttribute('data-personalized', selected.length ? 'yes' : 'no');

          document.querySelectorAll('[data-schools]').forEach(function (el) {
            if (el.closest('[data-ignore-prefs]')) { el.hidden = false; return; }
            var ids = (el.getAttribute('data-schools') || '').split(',');
            var relevant = selected.length === 0 || ids.some(function (id) {
              return id === 'district' || selected.indexOf(id) !== -1;
            });
            el.hidden = !relevant;
          });

          document.querySelectorAll('[data-empty-for]').forEach(function (el) {
            var list = document.querySelector('[data-bucket="' + el.getAttribute('data-empty-for') + '"]');
            if (!list) return;
            var visible = Array.prototype.slice.call(list.children).some(function (c) { return !c.hidden; });
            el.hidden = visible;
          });

          var names = {};
          try { names = JSON.parse(document.body.getAttribute('data-school-names') || '{}'); } catch (e) { /* keep ids */ }
          document.querySelectorAll('[data-school-name]').forEach(function (el) {
            el.textContent = selected.length
              ? selected.map(function (id) { return names[id] || id; }).join(' & ')
              : 'District 44';
          });

          /* Reactive: follows the current selection, so the headline names
             your schools the moment you tap one. */
          document.querySelectorAll('[data-needs-prefs]').forEach(function (el) { el.hidden = selected.length > 0; });
          document.querySelectorAll('[data-has-prefs]').forEach(function (el) { el.hidden = selected.length === 0; });

          /* Decided once, on load. Hiding the setup card the moment the first
             school is tapped takes the control away mid-interaction, so a
             parent with two children cannot pick the second one. */
          document.querySelectorAll('[data-onboarding]').forEach(function (el) { el.hidden = hadPrefsOnLoad; });
          document.querySelectorAll('[data-onboarded]').forEach(function (el) { el.hidden = !hadPrefsOnLoad; });

          if (window.d44.collapseDuplicates) window.d44.collapseDuplicates(document);

          /* "Coming up" renders the whole window so personalization has
             something to choose from; only a readable slice is shown. */
          /* Same treatment for "Don't forget": show the soonest few that are
             actually this parent's. */
          var expiring = document.querySelector('[data-expires]');
          if (expiring) {
            var kept = 0;
            Array.prototype.slice.call(expiring.children).forEach(function (card) {
              if (card.hidden) return;
              if (kept < 4) { kept++; return; }
              card.hidden = true;
            });
            var section = expiring.closest('section');
            if (section) section.hidden = kept === 0;
          }

          var upcoming = document.querySelector('[data-bucket="upcoming"]');
          if (upcoming) {
            var shown = 0;
            var cappedCount = 0;
            Array.prototype.slice.call(upcoming.children).forEach(function (card) {
              if (card.hidden) return;
              if (shown < 12) { shown++; return; }
              card.hidden = true;
              cappedCount++;
            });
            var more = document.querySelector('[data-more-link]');
            if (more) more.hidden = cappedCount === 0;
          }

          updateWeekStrip(localToday());

          document.querySelectorAll('[data-empty-for]').forEach(function (el) {
            var list = document.querySelector('[data-bucket="' + el.getAttribute('data-empty-for') + '"]');
            if (!list) return;
            var visible = Array.prototype.slice.call(list.children).some(function (c) { return !c.hidden; });
            el.hidden = visible;
          });
        }

        /* "Add to calendar": build a one-event .ics from what is already on the
           card, at click time. Embedding the files inline instead cost ~300KB
           on the calendar page. */
        function pad(n) { return n < 10 ? '0' + n : '' + n; }
        function stampUtc(d) {
          return d.getUTCFullYear() + pad(d.getUTCMonth() + 1) + pad(d.getUTCDate()) + 'T' +
                 pad(d.getUTCHours()) + pad(d.getUTCMinutes()) + pad(d.getUTCSeconds()) + 'Z';
        }
        function stampDate(iso) { return iso.slice(0, 10).replace(/-/g, ''); }
        function esc(v) { return String(v).replace(/([,;\\])/g, '\\$1').replace(/\n/g, '\\n'); }

        function buildIcs(card) {
          var allDay = card.hasAttribute('data-allday');
          var titleEl = card.querySelector('.title');
          var locEl = card.querySelector('.event-loc');
          var srcEl = card.querySelector('.source-line a');
          var title = titleEl ? titleEl.textContent.trim() : 'Event';
          var lines = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//' + document.title.split(' · ').pop() + '//EN', 'CALSCALE:GREGORIAN', 'BEGIN:VEVENT'];
          lines.push('UID:' + card.getAttribute('data-date') + '-' + Math.abs(hash(title)) + '@d44-parent-hub');
          lines.push('DTSTAMP:' + stampUtc(new Date()));

          if (allDay) {
            var endDay = new Date((card.getAttribute('data-end') || card.getAttribute('data-date')) + 'T12:00:00Z');
            endDay.setUTCDate(endDay.getUTCDate() + 1); // ICS all-day DTEND is exclusive
            lines.push('DTSTART;VALUE=DATE:' + stampDate(card.getAttribute('data-date')));
            lines.push('DTEND;VALUE=DATE:' + stampDate(endDay.toISOString()));
          } else {
            var startAt = card.getAttribute('data-start-at');
            var endAt = card.getAttribute('data-end-at') || startAt;
            lines.push('DTSTART:' + stampUtc(new Date(startAt)));
            lines.push('DTEND:' + stampUtc(new Date(endAt)));
          }

          lines.push('SUMMARY:' + esc(title));
          if (locEl) lines.push('LOCATION:' + esc(locEl.textContent.trim()));
          if (srcEl) lines.push('DESCRIPTION:' + esc('Source: ' + srcEl.textContent.trim() + ' — ' + srcEl.href));
          lines.push('END:VEVENT', 'END:VCALENDAR');
          return lines.join('\r\n');
        }

        function hash(str) {
          var h = 0;
          for (var i = 0; i < str.length; i++) { h = (h << 5) - h + str.charCodeAt(i); h |= 0; }
          return h;
        }

        function enableIcsButtons() {
          document.querySelectorAll('button[data-ics]').forEach(function (btn) { btn.hidden = false; });
        }

        document.addEventListener('click', function (ev) {
          var btn = ev.target && ev.target.closest && ev.target.closest('button[data-ics]');
          if (!btn) return;
          var card = btn.closest('[data-date]');
          if (!card) return;
          var titleEl = card.querySelector('.title');
          var name = (titleEl ? titleEl.textContent.trim() : 'event')
            .toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 40) || 'event';
          var blob = new Blob([buildIcs(card)], { type: 'text/calendar;charset=utf-8' });
          var url = URL.createObjectURL(blob);
          var a = document.createElement('a');
          a.href = url;
          a.download = name + '.ics';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
        });

        /* The district and an individual school often publish the same day
           ("Early Release Day" vs "EARLY RELEASE DAY - 1:15pm Dismissal").
           Once we know which schools this parent picked, prefer the school's
           own feed over the district's copy: it is the more specific one, and
           usually carries the actual dismissal time. Only the district copy is
           ever hidden, and only when the school's own version is visible.

           Visibility is owned by the card itself on most pages, but by a
           filter wrapper on the calendar page, so resolve that first. */
        function visibilityOwner(card) {
          return card.closest('[data-category]') || card;
        }

        /* Titles for the same event rarely nest neatly: the district writes
           "Pleasant Lane Picture Day" while the school writes "School Picture
           Day!". Prefix matching misses that, so compare word sets instead and
           treat one as a duplicate when its words are all contained in the
           other. Two words minimum, so a bare "Meeting" cannot swallow
           something more specific. */
        function words(key) {
          return (key || '').split(' ').filter(function (w) { return w.length > 2; });
        }

        function sameEvent(keyA, keyB) {
          var a = words(keyA);
          var b = words(keyB);
          if (!a.length || !b.length) return false;
          var short = a.length <= b.length ? a : b;
          var long = a.length <= b.length ? b : a;
          if (short.length < 2) return short[0] === long[0] && long.length === 1;
          return short.every(function (w) { return long.indexOf(w) !== -1; });
        }

        function collapseDuplicates(scope) {
          var byDate = {};
          scope.querySelectorAll('[data-title-key]').forEach(function (card) {
            if (card.closest('[data-ignore-prefs]')) return;
            var owner = visibilityOwner(card);
            if (owner.hidden) return;
            var d = card.getAttribute('data-date');
            (byDate[d] = byDate[d] || []).push(card);
          });

          Object.keys(byDate).forEach(function (date) {
            var cards = byDate[date];
            cards.forEach(function (a) {
              if (a.getAttribute('data-source-id') !== 'd44-district') return;
              var ownerA = visibilityOwner(a);
              if (ownerA.hidden) return;
              var ak = a.getAttribute('data-title-key');
              for (var i = 0; i < cards.length; i++) {
                var b = cards[i];
                if (b === a) continue;
                if (b.getAttribute('data-source-id') === 'd44-district') continue;
                if (visibilityOwner(b).hidden) continue;
                if (sameEvent(ak, b.getAttribute('data-title-key'))) {
                  ownerA.hidden = true;
                  return;
                }
              }
            });
          });
        }
        window.d44.collapseDuplicates = collapseDuplicates;

        /* Week strip: recompute against the device clock and whatever is
           actually visible to this parent, so it always agrees with the lists
           below it. Precedence is what a parent needs to act on first. */
        var WEEK_LABELS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'];
        var WEEK_TEXT = { off: 'No school', early: 'Early out', action: 'Plan ahead', busy: '', quiet: '' };

        function dayNumberOf(iso) {
          return String(parseInt(iso.slice(8, 10), 10));
        }

        function updateWeekStrip(today) {
          var strip = document.querySelector('[data-week-strip]');
          if (!strip) return;
          var week = schoolWeek(today);

          /* One card per event is enough; a card hidden by preferences or
             collapsed as a duplicate must not colour the strip. */
          var visible = [];
          document.querySelectorAll('[data-date][data-category]').forEach(function (card) {
            var owner = card.closest('[data-category]') === card ? card : card;
            if (owner.hidden || card.hidden) return;
            if (card.closest('[data-ignore-prefs]')) return;
            visible.push(card);
          });

          var notable = [];
          strip.querySelectorAll('[data-week-cell]').forEach(function (cell, i) {
            var date = addDays(week[0], i);
            var status = 'quiet';
            for (var n = 0; n < visible.length; n++) {
              var card = visible[n];
              var start = card.getAttribute('data-date');
              var end = card.getAttribute('data-end') || start;
              if (start > date || end < date) continue;
              var cat = card.getAttribute('data-category');
              if (cat === 'no-school' || cat === 'holiday') { status = 'off'; break; }
              if (cat === 'early-dismissal') { status = 'early'; continue; }
              if (status === 'early') continue;
              if (card.hasAttribute('data-action')) { status = 'action'; continue; }
              if (status !== 'action') status = 'busy';
            }

            cell.className = 'week-day is-' + status + (date === today ? ' is-today' : '');
            cell.setAttribute('data-week-date', date);
            cell.querySelector('.wd').textContent = WEEK_LABELS[i];
            cell.querySelector('.wn').textContent = dayNumberOf(date);
            cell.querySelector('.wtext').textContent = WEEK_TEXT[status] || '';
            if (status === 'off' || status === 'early') {
              notable.push(WEEK_LABELS[i] + ': ' + (status === 'off' ? 'no school' : 'early dismissal'));
            }
          });

          var summary = document.querySelector('[data-week-summary]');
          if (summary) {
            summary.textContent = notable.length
              ? notable.join(' · ')
              : 'No days off or early dismissals this week.';
          }
        }

        window.d44.apply = apply;
        repartition(localToday());
        apply();
        enableIcsButtons();
        window.addEventListener('pageshow', function () { repartition(localToday()); apply(); });

        if ('serviceWorker' in navigator) {
          window.addEventListener('load', function () {
            navigator.serviceWorker.register(document.body.dataset.base + 'sw.js').catch(function () {});
          });
        }
      })();
    </script>
  </body>
</html>
