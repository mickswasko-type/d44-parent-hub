---
/** Provenance, shown on every aggregated record. Never omit this. */
import { sinceLabel } from '../lib/dates';
interface Props { sourceName: string; sourceUrl: string; lastChecked?: string | null; }
const { sourceName, sourceUrl, lastChecked = null } = Astro.props;
---
<p class="source">
  <span>Source: <a href={sourceUrl} rel="noopener">{sourceName}</a></span>
  {lastChecked && <span>· Last checked {sinceLabel(lastChecked)}</span>}
</p>
